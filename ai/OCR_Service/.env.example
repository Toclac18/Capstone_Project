# ── Mạng ─────────────────────────────────────────────────────────────────
# 127.0.0.1, KHÔNG 0.0.0.0: endpoint nhận đường dẫn file nên không được mở
# ra ngoài máy.
OCR_HOST=127.0.0.1
OCR_PORT=9000

# ── Poppler (pdf2image) ──────────────────────────────────────────────────
# Để TRỐNG trên Linux/macOS (poppler nằm trong PATH).
# Windows: trỏ tới ...\poppler-xx\Library\bin
POPPLER_PATH=

# ── OCR ──────────────────────────────────────────────────────────────────
# DPI render trang trước khi OCR. 150 là mức cân bằng tốc độ/chất lượng.
OCR_DPI=150
# Số trang render song song (bước nhận dạng vẫn tuần tự vì PaddleOCR không
# thread-safe).
OCR_WORKERS=4

# ── Thư mục đầu vào được phép ────────────────────────────────────────────
# Mặc định chỉ cho đọc file trong thư mục tạm của hệ thống, nơi
# Readee_AI_System ghi PDF tạm. Thêm thư mục khác ở đây, phân cách bằng ":"
# (Linux/macOS) hoặc ";" (Windows).
OCR_INPUT_DIRS=
