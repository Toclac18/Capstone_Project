# ── Bảo mật ──────────────────────────────────────────────────────────────
# API key để backend gọi vào AI service.
# Để TRỐNG = chế độ mở, mọi request đều qua (chỉ dùng khi dev).
API_KEY=

# Shared secret để KÝ webhook callback gửi về backend (HMAC-SHA256 trên raw body).
# PHẢI giống hệt AI_WEBHOOK_SECRET ở backend, nếu không backend trả 401 và
# document sẽ treo ở trạng thái đang xử lý.
#   sinh khoá:  openssl rand -hex 32
AI_WEBHOOK_SECRET=

# Origin được phép gọi từ browser, phân cách bằng dấu phẩy. Để trống = tắt
# CORS. Backend gọi server-to-server nên bình thường không cần đặt.
AI_CORS_ORIGINS=

# ── Mạng ─────────────────────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8000
# OCR_Service (chạy local, nghe 127.0.0.1)
OCR_SERVICE_URL=http://127.0.0.1:9000
OCR_TIMEOUT=600

# ── Model summary (Llama) ────────────────────────────────────────────────
MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=
SAFE_INPUT_TOKENS=1024
PER_CHUNK_BUDGET=128
GPU_MAX_MEM=11000MiB
LOCAL_ONLY=0
# Số summary chạy đồng thời trên GPU
MAX_GPU_CONCURRENCY=2

# ── Model kiểm duyệt ─────────────────────────────────────────────────────
TEXT_MODEL_PATH=
IMAGE_MODEL_PATH=
TEXT_THRESHOLD=0.5
# LƯU Ý: từ bản sửa thiếu softmax, ngưỡng này áp lên xác suất thật chứ không
# phải logit thô, nên số ảnh bị chặn sẽ tăng so với trước.
IMAGE_THRESHOLD=0.5
# Số ảnh đưa vào GPU mỗi lượt (chống OOM khi PDF có nhiều ảnh)
IMAGE_BATCH_SIZE=32

# ── Giới hạn đầu vào ─────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_LENGTH=1000000
